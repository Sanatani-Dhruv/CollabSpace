@{
    ViewData["Title"] = "Create Workspace";
}

<div class="container py-5" style="max-width: 600px;">
    <h1 class="mb-3">Create a workspace</h1>
    <p class="text-muted mb-4">
        Start a shared space for notes and drawings.
    </p>

    <form asp-controller="Rooms" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label for="name" class="form-label">Workspace name</label>
            <input id="name"
                   name="name"
                   class="form-control"
                   maxlength="100"
                   required
                   autofocus
                   value="@ViewData["RoomName"]"
                   placeholder="e.g. Computer Science Project" />
            <span class="text-danger">
                @Html.ValidationMessage("name")
            </span>
        </div>

        <button type="submit" class="btn btn-primary">
            Create workspace
        </button>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary ms-2">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
