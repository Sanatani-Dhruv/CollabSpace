@{
    ViewData["Title"] = ViewBag.RoomName;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <a asp-controller="Home" asp-action="Index"
               class="text-decoration-none">&larr; Home</a>
            <h1 class="h2 mt-2 mb-1">@ViewBag.RoomName</h1>
            <span class="text-muted">Shared workspace</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <code id="accessCode">@ViewBag.AccessCode</code>
            <button type="button" id="copyCode"
                    class="btn btn-outline-secondary btn-sm">
                Copy code
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <section class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Shared notes</h2>
                    <span id="saveStatus" class="small text-muted">Ready</span>
                </div>
                <div class="card-body">
                    <form id="noteForm">
                        @Html.AntiForgeryToken()
                        <textarea id="noteContent"
                                  class="form-control"
                                  rows="18"
                                  maxlength="500000"
                                  placeholder="Start writing your ideas..."
                                  spellcheck="true">@ViewBag.NoteContent</textarea>
                    </form>
                    <p class="small text-muted mt-2 mb-0">
                        Notes save automatically while you type.
                    </p>
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Drawing canvas</h2>
                    <div class="d-flex gap-2">
                        <input id="penColor" type="color" value="#202020"
                               class="form-control form-control-color"
                               aria-label="Pen color" />
                        <button type="button" id="clearCanvas"
                                class="btn btn-outline-danger btn-sm">
                            Clear
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="drawingCanvas"
                            class="w-100 border rounded"
                            style="height: 420px; touch-action: none;"></canvas>
                    <p class="small text-muted mt-2 mb-0">
                        Draw with your mouse or finger. Drawings are currently
                        local to this page and will reset when you reload.
                    </p>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.collabSpaceConfig = {
            roomId: @ViewBag.RoomId,
            saveNoteUrl: '@Url.Action("SaveNote", "Rooms", new { id = ViewBag.RoomId })'
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/10.0.0/signalr.min.js"></script>
    <script src="~/js/workspace.js" asp-append-version="true"></script>
}
