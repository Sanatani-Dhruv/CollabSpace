@{
    ViewData["Title"] = ViewBag.RoomName;
}

<style>
    .sticky-board {
        position: relative;
        min-height: 650px;
        overflow: auto;
        border: 1px solid var(--bs-border-color);
        border-radius: .5rem;
        background-color: var(--bs-tertiary-bg);
        background-image:
            linear-gradient(rgba(128,128,128,.09) 1px, transparent 1px),
            linear-gradient(90deg, rgba(128,128,128,.09) 1px, transparent 1px);
        background-size: 24px 24px;
    }

    .sticky-note {
        position: absolute;
        display: flex;
        flex-direction: column;
        min-width: 120px;
        min-height: 100px;
        max-width: calc(100% - 8px);
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.15);
        border-radius: 5px;
        box-shadow: 0 3px 9px rgba(0,0,0,.15);
    }

    .sticky-note-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5px;
        min-height: 34px;
        padding: 4px 6px;
        background: rgba(0,0,0,.06);
        cursor: grab;
        user-select: none;
        touch-action: none;
    }

    .sticky-note-header:active {
        cursor: grabbing;
    }

    .sticky-note-tools {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .sticky-note-tools button {
        padding: 1px 5px;
        line-height: 1.4;
    }

    .sticky-note-color {
        width: 26px;
        height: 25px;
        padding: 1px;
        border: 0;
        background: transparent;
        cursor: pointer;
    }

    .sticky-note-content {
        flex: 1;
        width: 100%;
        min-height: 0;
        padding: 9px;
        border: 0;
        outline: none;
        resize: none;
        background: transparent;
        color: #242424;
        font: inherit;
    }

    .sticky-note-resize {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 18px;
        height: 18px;
        cursor: nwse-resize;
        touch-action: none;
        background: linear-gradient(
            135deg,
            transparent 45%,
            rgba(0,0,0,.35) 46%,
            rgba(0,0,0,.35) 53%,
            transparent 54%,
            transparent 65%,
            rgba(0,0,0,.35) 66%,
            rgba(0,0,0,.35) 73%,
            transparent 74%
        );
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <a asp-controller="Home" asp-action="Index"
               class="text-decoration-none">&larr; Home</a>
            <h1 class="h2 mt-2 mb-1">@ViewBag.RoomName</h1>
            <span class="text-muted">Shared workspace</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <code id="accessCode">@ViewBag.AccessCode</code>
            <button type="button" id="copyCode"
                    class="btn btn-outline-secondary btn-sm">
                Copy code
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <section class="card shadow-sm">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h2 class="h5 mb-0">Sticky-note canvas</h2>
                        <span class="small text-muted">
                            Add ideas, move notes, resize them, and choose colors.
                        </span>
                    </div>
                    <button type="button" id="addCanvasNote"
                            class="btn btn-primary btn-sm">
                        + Add note
                    </button>
                </div>
                <div class="card-body">
                    <div id="stickyNotesCanvas"
                         class="sticky-board"
                         aria-label="Collaborative sticky-note canvas"></div>
                    <p id="canvasNoteStatus"
                       class="small text-muted mt-2 mb-0"
                       role="status"
                       aria-live="polite">
                        Loading sticky notes…
                    </p>
                </div>
            </section>
        </div>
    </div>

    <!-- Hidden legacy sections kept in DOM so background JS bindings do not throw null references -->
    <div class="d-none">
        <form id="noteForm">
            @Html.AntiForgeryToken()
            <textarea id="noteContent">@ViewBag.NoteContent</textarea>
        </form>
        <span id="saveStatus">Ready</span>
        <input id="penColor" type="color" value="#202020" />
        <button type="button" id="clearCanvas">Clear</button>
        <canvas id="drawingCanvas"></canvas>
    </div>
</div>

@section Scripts {
    <script>
        window.collabSpaceConfig = {
            roomId: @ViewBag.RoomId,
            saveNoteUrl: '@Url.Action("SaveNote", "Rooms", new { id = ViewBag.RoomId })'
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/10.0.0/signalr.min.js"></script>
    <script src="~/js/workspace.js" asp-append-version="true"></script>
}
